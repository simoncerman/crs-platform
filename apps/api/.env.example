# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# SMTP (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@crs.local
ADMIN_EMAIL=admin@crs.local
